{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./web/src/*"]
    }
  },
  "include": ["desktop/**/*.cjs"]
}
