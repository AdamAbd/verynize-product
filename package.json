{
  "name": "verynize",
  "version": "0.18.0",
  "private": true,
  "description": "Independent local design editor reconstructed from documented Wonder workflows",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "imports": {
    "#cloud-runtime": {
      "workerd": "./cloud/platform/cloudflare/runtime.js",
      "default": "./cloud/platform/node/runtime.js"
    },
    "#mcp-env": {
      "workerd": "./cloud/mcp-env.js",
      "default": "./cloud/platform/node/mcp-env.js"
    }
  },
  "scripts": {
    "start": "node scripts/build-ui.cjs && electron .",
    "check": "node scripts/check.cjs",
    "build": "node scripts/build-ui.cjs && vp build",
    "build:web:node": "node scripts/build-ui.cjs && vp build -c vite.node.config.ts",
    "start:web:node": "node web-start/node/server.mjs",
    "build:web:nitro": "node scripts/build-ui.cjs && NITRO_PRESET=node-server vp build -c vite.nitro.config.ts",
    "build:web:nitro:vercel": "node scripts/build-ui.cjs && NITRO_PRESET=vercel vp build -c vite.nitro.config.ts",
    "start:web:nitro": "node dist/web-nitro/server/index.mjs",
    "deploy:check": "npm run build && cf deploy --prebuilt --dry-run",
    "deploy": "npm run build && cf deploy --prebuilt",
    "db:migrate": "node scripts/db-migrate.mjs",
    "start:server": "node server/node.mjs",
    "test": "node scripts/run-tests.mjs --all",
    "start:vercel-local": "node server/vercel-local.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test:canvas": "node scripts/run-tests.mjs --all --group canvas",
    "test:desktop": "node scripts/run-tests.mjs --all --group desktop",
    "test:web": "node scripts/run-tests.mjs --all --group web",
    "test:web:nitro": "node scripts/run-tests.mjs --all --group web-nitro",
    "test:integrations": "node scripts/run-tests.mjs --all --group integrations",
    "test:cloud": "node scripts/run-tests.mjs --all --group cloud",
    "test:cloud:node": "node scripts/run-tests.mjs --all --group cloud-node",
    "test:cloud:vercel": "node scripts/run-tests.mjs --all --group cloud-vercel",
    "mcp": "node integrations/mcp-server.mjs",
    "package:mac": "node scripts/package-macos.cjs",
    "cli": "node integrations/design-cli.mjs",
    "test:agents:live": "BD_LIVE_AGENTS=1 node --test tests/agent-runtime-live.cjs",
    "test:package": "node scripts/run-tests.mjs --all --group package",
    "dev": "node scripts/build-ui.cjs && vp dev",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test:ux": "node scripts/run-tests.mjs --all --group ux",
    "build:ui": "node scripts/build-ui.cjs",
    "lint:ui": "vp lint web/src",
    "typecheck:ui": "tsc -p tsconfig.json && tsc -p web-start/tsconfig.json",
    "eval:fidelity": "node eval/run-fidelity.mjs",
    "eval:judge": "node eval/run-judge.mjs",
    "eval:summary": "node eval/summarize.mjs",
    "eval:pairs": "node eval/make-pairs.mjs",
    "eval:score": "node eval/score-pairs.mjs",
    "eval:refs": "node eval/render-references.mjs",
    "eval:import": "node eval/run-import-fidelity.mjs",
    "test:full": "node scripts/run-tests.mjs --all",
    "test:changed": "node scripts/run-tests.mjs --changed",
    "test:list-changed": "node scripts/run-tests.mjs --changed --explain",
    "test:e2e-cloud": "node scripts/run-tests.mjs --all --group e2e-cloud",
    "check:identity": "node scripts/check-identity.mjs --staged --author",
    "prepare": "vp config --no-agent || true"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.148",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.43",
    "@iconify/utils": "^3.1.7",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/ai": "1.0.1",
    "@tanstack/ai-openrouter": "1.0.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@vercel/functions": "^3.10.5",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "node-pty": "1.2.0-beta.18",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "redis": "^6.3.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.6",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-start": "^1.169.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.26",
    "electron": "^42.0.0",
    "miniflare": "^5.20261023.1-beta",
    "nitro": "3.0.261029-rc",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "workerd": true,
    "node-pty": true,
    "fsevents": true,
    "@openrouter/sdk": false
  }
}
