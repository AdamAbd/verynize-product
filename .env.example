# Crash reports (Sentry), docs/telemetry.md. Copy to .env (git-ignored); never commit real values.
# npm run build, deploy, deploy:check and package:mac load it (scripts/env.mjs); exported variables win over it.
# Local deploy from this Mac: fill SENTRY_DSN_WEB, SENTRY_DSN_DESKTOP and SENTRY_AUTH_TOKEN here, and
# SENTRY_DSN_SERVER either here (built into the Worker) or as a Worker secret (docs/telemetry.md).
# Client reporting is opt-in in Settings › Preferences › Privacy; without a DSN the SDKs never start.
SENTRY_DSN_DESKTOP=        # verynize-desktop: dev runs read it at launch; npm run package:mac bakes it into the app
SENTRY_DSN_WEB=            # verynize-web: read at build time (npm run build, so deploy too; build:web:*)
SENTRY_DSN_SERVER=         # verynize-server: here (built in by npm run build) or a Worker secret (wins); Node/Vercel: runtime env
SENTRY_ENVIRONMENT=        # optional; defaults: desktop production|development, web Vite mode, server cloudflare|node|vercel
SENTRY_RELEASE=            # optional; web/server default to the deploy commit SHA
SENTRY_SAMPLE_RATE=1       # errors
SENTRY_TRACES_SAMPLE_RATE=0.05
# Source-map upload (npm run build / package:mac). Unset: no maps are generated for upload and nothing is uploaded.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=adamabdrrahman
