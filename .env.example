# Crash reports (Sentry), docs/telemetry.md. Copy to .env (git-ignored) for local runs; never commit real values.
# Client reporting is opt-in in Settings › Preferences › Privacy; without a DSN the SDKs never start.
SENTRY_DSN_DESKTOP=        # verynize-desktop: dev runs read it at launch; npm run package:mac bakes it into the app
SENTRY_DSN_WEB=            # verynize-web: read at build time (npm run build / build:web:*)
SENTRY_DSN_SERVER=         # verynize-server: Worker secret or build time; Node/Vercel runtime environment
SENTRY_ENVIRONMENT=        # optional; defaults: desktop production|development, web Vite mode, server cloudflare|node|vercel
SENTRY_RELEASE=            # optional; web/server default to the deploy commit SHA
SENTRY_SAMPLE_RATE=1       # errors
SENTRY_TRACES_SAMPLE_RATE=0.05
# Source-map upload (CI only). Unset: no maps are generated for upload and nothing is uploaded.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=adamabdrrahman
