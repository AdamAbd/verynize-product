{ "title": "HTML import: specificity, !important, inline style, inheritance, var() tokens and media queries at the viewport",
  "covers": ["html-import", "cascade", "tokens", "media"],
  "viewport": { "width": 1200, "height": 800 },
  "roundTrip": true,
  "expect": [
    { "node": "Row", "prop": "layout", "eq": "flex" },
    { "node": "Row", "prop": "gap", "eq": { "x": 16, "y": 16 } },
    { "node": "Plain", "prop": "padding", "eq": { "top": 20, "right": 20, "bottom": 20, "left": 32 } },
    { "node": "Plain", "prop": "radius", "eq": { "tl": 10, "tr": 10, "br": 10, "bl": 10 } },
    { "node": "Plain", "prop": "strokeWidth", "eq": 1 },
    { "node": "Plain", "prop": "strokeColor", "color": "#e5e7eb" },
    { "node": "Plain", "prop": "box", "eq": { "w": 420 } },
    { "node": "Plain", "prop": "bindings", "eq": { "radius": "radius" } },
    { "node": "Promo", "prop": "fill", "color": "#4f46e5" },
    { "node": "Promo", "prop": "token", "eq": "brand" },
    { "node": "h2.title", "prop": "fontSize", "eq": 12 },
    { "node": "h2.title", "prop": "fontWeight", "eq": 700 },
    { "node": "h2.title", "prop": "fontFamily", "eq": "Georgia, serif" },
    { "node": "p.muted", "prop": "ink", "color": "#6b7280" },
    { "node": "p.muted", "prop": "lineHeightPx", "eq": 24 },
    { "node": "Inline wins", "prop": "ink", "color": "#ffffff" },
    { "node": "Inline wins", "prop": "fontSize", "eq": 18 },
    { "rendered": "Plain", "prop": "w", "eq": 420 },
    { "rendered": "Promo", "relTo": "Row", "eq": { "x": 436 } }
  ] }
